{
  "name": "dualsync",
  "version": "1.0.0",
  "description": "Real-time synchronized music and podcast co-listening web app with WebRTC voice chat and custom player controls",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm install && npm run build:client",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "webrtc",
    "synchronous-listening",
    "music-sync",
    "youtube",
    "spotify",
    "socketio",
    "react"
  ],
  "author": "Vetrans",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
